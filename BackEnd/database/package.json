{
  "name": "@zenchat/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d dist/data-source.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "typescript": "^5.9.3"
  }
}

